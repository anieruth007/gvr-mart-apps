{
  "name": "gvr-mart-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "backend:dev": "npm run start:dev --workspace backend",
    "backend:seed": "npm run seed --workspace backend",
    "consumer:start": "npm run start --workspace @gvr-mart/consumer",
    "delivery-admin:start": "npm run start --workspace @gvr-mart/delivery-admin"
  }
}
